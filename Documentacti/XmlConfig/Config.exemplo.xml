<?xml version="1.0"?>
<!--
  Copie este arquivo para Config.xml (na pasta XmlConfig ao lado do executável).
  Usado SOMENTE em Debug (testes em base local / FTP de testes). Em Release o banco e o FTP vêm
  compilados no executável (Module\modConexao.vb) e este arquivo não é lido.
  O Config.xml contém credenciais: NÃO versionar.
-->
<Documentacti>
  <ConfigDatabase>
    <StringConnection>Server=127.0.0.1;Port=3306;Database=plataforma_prd_copia;Uid=root;Pwd=root;CharSet=utf8mb4;Convert Zero Datetime=true;</StringConnection>
  </ConfigDatabase>USUARIO
  <!-- FTP dos anexos de chamado (FTP sobre TLS). Informe o caminho com barra final. -->
  <Ftp>
    <Caminho>ftp://SERVIDOR/CAMINHO/DOS/ANEXOS/</Caminho>
    <Usuario>USUARIO</Usuario>
    <Senha>SENHA</Senha>
  </Ftp>
</Documentacti>
